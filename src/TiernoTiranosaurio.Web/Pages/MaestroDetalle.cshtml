@page
@model MaestroDetalleModel
@{
    ViewData["Title"] = "Maestro-Detalle";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="fa-solid fa-layer-group"></i> Maestro-Detalle por Tipo de Mascota</h2>
        <p class="page-subtitle">Maestro: <code>TipoMascota</code> (<code>GET api/tiposmascota</code>) · Detalle: <code>Mascota</code> (<code>GET api/mascotas?idTipo=...</code>)</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorApi))
{
    <div class="alerta alerta-error"><i class="fa-solid fa-triangle-exclamation"></i> @Model.ErrorApi</div>
}

<div class="card">
    <h3 style="margin-top:0; font-size:1.1rem; color:var(--color-secundario);">
        1. Maestro — Selecciona un Tipo de Mascota:
    </h3>

    <div class="tipos-grid">
        @foreach (var t in Model.Tipos)
        {
            bool esActivo = Model.IdTipo == t.IdTipo;
            <a asp-page="/MaestroDetalle" asp-route-IdTipo="@t.IdTipo" class="tipo-pill @(esActivo ? "activo" : "")">
                <span class="tipo-emoji"><i class="@MaestroDetalleModel.ClaseIconoTipo(t.Nombre)"></i></span>
                <span>@t.Nombre</span>
                <small style="opacity:0.8; font-weight:400;">ID: @t.IdTipo</small>
            </a>
        }
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <span class="stat-label"><i class="fa-solid fa-paw"></i> Total @(Model.TipoSeleccionado?.Nombre ?? "")</span>
        <span class="stat-value">@Model.MascotasDelTipo.Count</span>
    </div>
    <div class="stat-card acento">
        <span class="stat-label"><i class="fa-solid fa-circle-check"></i> Disponibles en Categoría</span>
        <span class="stat-value">@Model.DisponiblesDelTipo</span>
    </div>
    <div class="stat-card coral">
        <span class="stat-label"><i class="fa-solid fa-tag"></i> Vendidas en Categoría</span>
        <span class="stat-value">@Model.VendidasDelTipo</span>
    </div>
    <div class="stat-card secundario">
        <span class="stat-label"><i class="fa-solid fa-coins"></i> Valor Categoría</span>
        <span class="stat-value">@Model.ValorTotalDelTipo.ToString("C0", MaestroDetalleModel.Pesos)</span>
    </div>
</div>

<div class="card">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; margin-bottom:1rem;">
        <h3 style="margin:0; font-size:1.15rem; color:var(--color-secundario);">
            2. Detalle — Mascotas del tipo:
            <span style="color:var(--color-primario);">@(Model.TipoSeleccionado?.Nombre ?? "Ninguno")</span>
        </h3>
        <span class="badge badge-disponible">
            @Model.MascotasDelTipo.Count mascota(s) en esta categoría
        </span>
    </div>

    @if (Model.MascotasDelTipo.Count == 0)
    {
        <div class="alerta alerta-vacio">
            No hay mascotas registradas para este tipo.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Raza</th>
                        <th>Edad (meses)</th>
                        <th>Precio</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.MascotasDelTipo)
                    {
                        bool disponible = m.Estado == EstadosMascota.Disponible;
                        <tr>
                            <td><span class="codigo-tag">#@m.Codigo</span></td>
                            <td><strong>@m.Nombre</strong></td>
                            <td>@m.Raza</td>
                            <td>@m.Edad meses</td>
                            <td class="precio-col">@m.Precio.ToString("C0", MaestroDetalleModel.Pesos)</td>
                            <td>
                                <span class="badge @(disponible ? "badge-disponible" : "badge-vendida")">
                                    @(disponible ? "Disponible" : "Vendida")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
